<footer class="border-t border-slate-200 dark:border-slate-800 bg-white/50 dark:bg-slate-900/50 backdrop-blur py-8 mt-16 text-center text-xs text-slate-500 dark:text-slate-400">
  <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-2">
      <span class="font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5"><%- I('zap', 'w-3.5 h-3.5 text-sky-500') %> <%= typeof G !== 'undefined' && G.siteName ? G.siteName : 'Nxpress' %></span>
      <span>•</span>
      <span>v<%= typeof G !== 'undefined' && G.version ? G.version : '1.0.0' %></span>
    </div>
    <div class="flex items-center gap-6">
      <a href="/products" class="hover:text-sky-500 transition-colors"><%= typeof tr === 'function' ? tr('products') : 'Products' %></a>
      <a href="/dashboard" class="hover:text-sky-500 transition-colors"><%= typeof tr === 'function' ? tr('dashboard') : 'Dashboard' %></a>
      <a href="/api/health" class="hover:text-sky-500 transition-colors">API Status</a>
      <a href="/about" class="hover:text-sky-500 transition-colors"><%= typeof tr === 'function' ? tr('about') : 'About' %></a>
    </div>
    <p>&copy; <%= new Date().getFullYear() %> <%= typeof G !== 'undefined' && G.author ? G.author : 'Nxpress Team' %> — Built with <strong>Nxpress</strong></p>
  </div>
</footer>
