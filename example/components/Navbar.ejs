<header class="bg-white/80 dark:bg-slate-800/80 backdrop-blur border-b border-slate-200 dark:border-slate-700/60 sticky top-0 z-50 transition-colors">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="text-xl font-extrabold text-slate-900 dark:text-white flex items-center gap-2 tracking-tight hover:opacity-90">
      <span class="p-1.5 rounded-lg bg-sky-500 text-white flex items-center justify-center text-xs">⚡</span>
      <%= G.siteName %>
    </a>

    <nav class="flex items-center gap-5 text-sm font-medium">
      <a href="/" class="text-slate-600 dark:text-slate-300 hover:text-sky-500 dark:hover:text-sky-400 transition-colors">
        <%= tr('home') %>
      </a>
      <a href="/products" class="text-slate-600 dark:text-slate-300 hover:text-sky-500 dark:hover:text-sky-400 transition-colors">
        <%= tr('products') %>
      </a>
      <a href="/dashboard" class="text-slate-600 dark:text-slate-300 hover:text-sky-500 dark:hover:text-sky-400 transition-colors flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <%= tr('dashboard') %>
      </a>
      <a href="/about" class="text-slate-600 dark:text-slate-300 hover:text-sky-500 dark:hover:text-sky-400 transition-colors">
        <%= tr('about') %>
      </a>
      <a href="/api/health" target="_blank" class="px-2.5 py-1 rounded-md text-xs font-semibold bg-emerald-50 text-emerald-600 dark:bg-emerald-950/50 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/40">
        API
      </a>

      <!-- i18n switcher -->
      <div class="flex items-center bg-slate-100 dark:bg-slate-700/60 p-0.5 rounded-lg text-xs font-semibold">
        <a href="?lang=en" class="px-2 py-1 rounded <%= (typeof R !== 'undefined' && R && R.locale === 'en') || (!R || !R.locale) ? 'bg-white dark:bg-slate-800 text-sky-600 dark:text-sky-400 shadow-sm' : 'text-slate-500 hover:text-slate-900 dark:text-slate-400' %>">EN</a>
        <a href="?lang=fr" class="px-2 py-1 rounded <%= typeof R !== 'undefined' && R && R.locale === 'fr' ? 'bg-white dark:bg-slate-800 text-sky-600 dark:text-sky-400 shadow-sm' : 'text-slate-500 hover:text-slate-900 dark:text-slate-400' %>">FR</a>
      </div>

      <!-- Auth Link -->
      <a href="/login" class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-sky-500 hover:bg-sky-600 text-white transition-colors shadow-sm">
        <%= tr('login') %>
      </a>

      <!-- Theme Switcher -->
      <button onclick="__nxpress__.theme.toggle()" class="p-2 rounded-lg bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:text-sky-500 dark:hover:text-sky-400 transition-colors" title="Toggle Theme">
        <%- I('moon', 'w-4 h-4 dark:hidden') %>
        <%- I('sun', 'w-4 h-4 hidden dark:block') %>
      </button>
    </nav>
  </div>
</header>
