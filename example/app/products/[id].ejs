<div class="space-y-10">
  <!-- Back Link -->
  <div>
    <a href="/products" class="inline-flex items-center gap-2 text-xs font-semibold text-sky-500 hover:text-sky-600 transition-colors">
      &larr; <%= tr('back_to_products') %>
    </a>
  </div>

  <% if (product) { %>
    <!-- Product Detail Card -->
    <div class="bg-white dark:bg-slate-800/90 rounded-3xl p-8 md:p-10 border border-slate-200/80 dark:border-slate-700/60 shadow-lg">
      <div class="flex flex-col md:flex-row md:items-start justify-between gap-6 pb-8 border-b border-slate-100 dark:border-slate-700/60">
        <div class="space-y-3">
          <div class="flex items-center gap-3">
            <span class="px-3 py-1 rounded-full text-xs font-semibold bg-sky-50 dark:bg-sky-950/60 text-sky-600 dark:text-sky-400 border border-sky-200/80 dark:border-sky-800/50">
              <%= product.category %>
            </span>
            <div class="flex items-center gap-1 text-xs font-bold text-amber-500">
              <%- I('star', 'w-3.5 h-3.5 fill-amber-400 text-amber-400') %>
              <span><%= product.rating %> / 5.0</span>
            </div>
          </div>
          <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white">
            <%= product.name %>
          </h1>
          <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl">
            <%= product.description %>
          </p>
        </div>

        <div class="text-left md:text-right bg-slate-50 dark:bg-slate-900/60 p-6 rounded-2xl border border-slate-100 dark:border-slate-800 min-w-[220px]">
          <div class="text-xs text-slate-400 mb-1"><%= tr('price') %></div>
          <div class="text-3xl font-black text-slate-900 dark:text-white">
            <%= product.price %> <%= G.currency %>
          </div>
          <div class="mt-2 text-xs font-semibold flex items-center justify-start md:justify-end gap-1.5 <%= product.stock > 10 ? 'text-emerald-500' : 'text-amber-500' %>">
            <span class="w-2 h-2 rounded-full bg-current"></span>
            <span><%= product.stock %> <%= tr('units_available') %></span>
          </div>
          <button onclick="alert('Commande validée pour : <%= product.name %>')" class="mt-6 w-full py-3 px-4 rounded-xl text-xs font-bold bg-sky-500 hover:bg-sky-600 text-white transition-colors shadow-md shadow-sky-500/20">
            Acheter maintenant &rarr;
          </button>
        </div>
      </div>

      <!-- Live API Info -->
      <div class="pt-6 flex flex-wrap items-center justify-between text-xs text-slate-400 gap-4">
        <div>Endpoint API : <code class="text-sky-500">/api/products/<%= product.id %></code></div>
        <div>SSR Param : <code>id = <%= product.id %></code></div>
      </div>
    </div>

    <!-- Related Products -->
    <% if (related && related.length > 0) { %>
      <div class="space-y-6 pt-4">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white">Produits similaires</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          <% related.forEach(function(item) { %>
            <%- $('ProductCard', { product: item }) %>
          <% }); %>
        </div>
      </div>
    <% } %>

  <% } else { %>
    <div class="p-12 text-center bg-white dark:bg-slate-800/80 rounded-3xl border border-slate-200 dark:border-slate-800">
      <div class="flex justify-center mb-3 text-amber-500">
        <%- I('alert-triangle', 'w-10 h-10') %>
      </div>
      <h2 class="text-xl font-bold text-slate-900 dark:text-white">Produit non trouvé</h2>
      <p class="text-xs text-slate-400 mt-2">Le produit demandé n'existe pas dans la base de démonstration.</p>
      <a href="/products" class="inline-block mt-6 px-4 py-2 rounded-xl text-xs font-bold bg-sky-500 text-white">
        <%= tr('back_to_products') %>
      </a>
    </div>
  <% } %>
</div>
