<div class="space-y-12">
  <!-- Back Link -->
  <div>
    <a href="/products" class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#2c6153] dark:text-[#64bfa9] hover:underline">
      &larr; <%= tr('back_to_products') %>
    </a>
  </div>

  <% if (product) { %>
    <!-- Product Detail Card -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 bg-white dark:bg-[#18201d] rounded-3xl p-6 sm:p-10 border border-[#eee8dc] dark:border-[#26332d] shadow-sm items-center">
      
      <!-- Product Image Box -->
      <div class="md:col-span-6 rounded-2xl overflow-hidden aspect-square bg-[#f2eee6] dark:bg-[#1f2a25] flex items-center justify-center p-4">
        <img src="<%= product.image || 'https://images.unsplash.com/photo-1584990347449-35c824c9657f?w=800&auto=format&fit=crop&q=80' %>" 
             alt="<%= product.name %>" 
             class="w-full h-full object-cover rounded-xl" />
      </div>

      <!-- Product Info -->
      <div class="md:col-span-6 space-y-6">
        <div>
          <div class="flex items-center gap-3 mb-2">
            <% if (product.badge) { %>
              <span class="px-3 py-1 rounded-full text-xs font-medium bg-[#f1ece1] dark:bg-[#1f2a25] text-[#3d524a] dark:text-[#c4d6cf]">
                <%= product.badge %>
              </span>
            <% } %>
            <div class="flex items-center gap-1 text-xs font-bold text-amber-500">
              <%- I('star', 'w-3.5 h-3.5 fill-amber-400 text-amber-400') %>
              <span><%= product.rating %> / 5.0</span>
            </div>
          </div>

          <h1 class="text-3xl sm:text-4xl font-bold text-[#1a2e28] dark:text-white leading-tight">
            <%= product.name %>
          </h1>

          <div class="mt-4 text-3xl font-extrabold text-[#1a2b25] dark:text-[#64bfa9]">
            <%= typeof G !== 'undefined' && G.currency ? G.currency : '$' %><%= product.price.toFixed ? product.price.toFixed(2) : product.price %>
          </div>
        </div>

        <p class="text-sm text-[#5c6e66] dark:text-[#a0b3aa] leading-relaxed">
          <%= product.description %>
        </p>

        <!-- Color Selection -->
        <div class="space-y-2">
          <span class="text-xs font-semibold text-[#7a8c84] uppercase tracking-wider block">Available Colors</span>
          <div class="flex items-center gap-2">
            <% if (product.colors && product.colors.length > 0) { %>
              <% product.colors.forEach(function(c) { %>
                <button class="w-6 h-6 rounded-full border-2 border-white dark:border-black shadow-sm ring-1 ring-black/10" style="background-color: <%= c %>;"></button>
              <% }); %>
            <% } else { %>
              <span class="w-6 h-6 rounded-full bg-[#6fa89c]"></span>
              <span class="w-6 h-6 rounded-full bg-[#9dbcb5]"></span>
              <span class="w-6 h-6 rounded-full bg-[#3a574f]"></span>
            <% } %>
          </div>
        </div>

        <div class="pt-4 border-t border-[#eee8dc] dark:border-[#26332d] flex items-center gap-4">
          <button onclick="alert('Added to cart: <%= product.name %>')" class="flex-1 py-3.5 px-6 rounded-full text-xs font-bold bg-[#1b362f] hover:bg-[#284f45] dark:bg-[#2e5e52] text-white transition-all shadow-md">
            Add to Cart &rarr;
          </button>
          <div class="text-xs font-medium text-[#7a8c84]">
            <%= product.stock %> <%= tr('units_available') %>
          </div>
        </div>
      </div>

    </div>

    <!-- Related Products -->
    <% if (related && related.length > 0) { %>
      <div class="space-y-6 pt-6">
        <h2 class="text-2xl font-bold text-[#1a2e28] dark:text-white">
          Related <span class="font-serif-italic font-normal text-[#2c6153] dark:text-[#64bfa9]">Products</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          <% related.forEach(function(item) { %>
            <%- $('ProductCard', { product: item }) %>
          <% }); %>
        </div>
      </div>
    <% } %>

  <% } else { %>
    <div class="p-16 text-center bg-[#f4efe6] dark:bg-[#18221e] rounded-3xl border border-[#e8e2d4] dark:border-[#26352f]">
      <div class="flex justify-center mb-3 text-amber-500">
        <%- I('alert-triangle', 'w-10 h-10') %>
      </div>
      <h2 class="text-xl font-bold text-[#1a2e28] dark:text-white">Product Not Found</h2>
      <p class="text-xs text-[#7a8c84] mt-2">The requested product could not be found.</p>
      <a href="/products" class="inline-block mt-6 px-5 py-2.5 rounded-full text-xs font-bold bg-[#1b362f] text-white">
        <%= tr('back_to_products') %>
      </a>
    </div>
  <% } %>
</div>
