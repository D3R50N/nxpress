<div class="space-y-8">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-6 border-b border-[#ece7df] dark:border-[#222b27]">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-[#2c6153]/10 text-[#2c6153] dark:bg-[#52aa95]/20 dark:text-[#64bfa9] border border-[#2c6153]/20">
          Protected Area
        </span>
        <span class="text-xs text-[#7a8c84]">Cascading Middleware Active</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold text-[#1a2e28] dark:text-white">
        Homedine <span class="font-serif-italic font-normal text-[#2c6153] dark:text-[#64bfa9]"><%= tr('dashboard') %></span>
      </h1>
      <p class="text-xs sm:text-sm text-[#667a71] dark:text-[#8ea399] mt-1">
        <%= tr('dashboard_welcome') %> Connecté en tant que <strong class="text-[#1a2e28] dark:text-white"><%= user.name %></strong> (<%= user.email %>).
      </p>
    </div>

    <div class="flex items-center gap-3">
      <button onclick="document.cookie='nxpress_user=; Max-Age=0; path=/'; window.location.href='/login';" class="px-4 py-2 rounded-full text-xs font-bold bg-rose-50 hover:bg-rose-100 text-rose-600 dark:bg-rose-950/40 dark:text-rose-400 border border-rose-200 dark:border-rose-800/40 transition-colors">
        <%= tr('logout') %>
      </button>
    </div>
  </div>

  <!-- Quick Stats Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-white dark:bg-[#18201d] rounded-2xl p-5 border border-[#eee8dc] dark:border-[#26332d]">
      <div class="text-xs font-semibold text-[#7a8c84] mb-1">Total Products</div>
      <div class="text-2xl font-bold text-[#1a2e28] dark:text-white"><%= stats.totalProducts %></div>
      <div class="text-[11px] text-[#2c6153] dark:text-[#64bfa9] mt-1">Live in store</div>
    </div>
    <div class="bg-white dark:bg-[#18201d] rounded-2xl p-5 border border-[#eee8dc] dark:border-[#26332d]">
      <div class="text-xs font-semibold text-[#7a8c84] mb-1">Total Stock</div>
      <div class="text-2xl font-bold text-[#1a2e28] dark:text-white"><%= stats.totalStock %></div>
      <div class="text-[11px] text-[#667a71] mt-1">Units available</div>
    </div>
    <div class="bg-white dark:bg-[#18201d] rounded-2xl p-5 border border-[#eee8dc] dark:border-[#26332d]">
      <div class="text-xs font-semibold text-[#7a8c84] mb-1">Inventory Value</div>
      <div class="text-2xl font-bold text-[#1a2e28] dark:text-white"><%= typeof G !== 'undefined' && G.currency ? G.currency : '$' %><%= stats.totalRevenue.toFixed ? stats.totalRevenue.toFixed(2) : stats.totalRevenue %></div>
      <div class="text-[11px] text-[#d98236] mt-1">Retail value</div>
    </div>
    <div class="bg-white dark:bg-[#18201d] rounded-2xl p-5 border border-[#eee8dc] dark:border-[#26332d]">
      <div class="text-xs font-semibold text-[#7a8c84] mb-1">Server Memory</div>
      <div class="text-2xl font-bold text-[#1a2e28] dark:text-white"><%= systemInfo.memory %></div>
      <div class="text-[11px] text-[#7a8c84] mt-1">Node <%= systemInfo.nodeVersion %></div>
    </div>
  </div>

  <!-- Products Inventory Table -->
  <div class="bg-white dark:bg-[#18201d] rounded-2xl border border-[#eee8dc] dark:border-[#26332d] overflow-hidden shadow-sm">
    <div class="p-5 border-b border-[#eee8dc] dark:border-[#26332d] flex items-center justify-between">
      <h2 class="text-sm font-bold text-[#1a2e28] dark:text-white">Product Inventory Management</h2>
      <a href="/products" class="text-xs font-semibold text-[#2c6153] dark:text-[#64bfa9] hover:underline">View Public Store &rarr;</a>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-[#faf8f4] dark:bg-[#151c19] text-[#7a8c84] border-b border-[#eee8dc] dark:border-[#26332d]">
          <tr>
            <th class="py-3 px-4 font-semibold">ID</th>
            <th class="py-3 px-4 font-semibold">Product</th>
            <th class="py-3 px-4 font-semibold">Category</th>
            <th class="py-3 px-4 font-semibold">Price</th>
            <th class="py-3 px-4 font-semibold">Stock</th>
            <th class="py-3 px-4 font-semibold">Rating</th>
            <th class="py-3 px-4 font-semibold text-right">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#eee8dc] dark:divide-[#26332d]">
          <% products.forEach(function(item) { %>
            <tr class="hover:bg-[#faf8f4]/60 dark:hover:bg-[#1f2a25]/40 transition-colors">
              <td class="py-3 px-4 font-mono text-[#8c9e96]">#<%= item.id %></td>
              <td class="py-3 px-4 font-bold text-[#1a2e28] dark:text-white flex items-center gap-2">
                <img src="<%= item.image %>" alt="" class="w-7 h-7 rounded-lg object-cover" />
                <span><%= item.name %></span>
              </td>
              <td class="py-3 px-4">
                <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-[#f1ece1] dark:bg-[#202b26] text-[#44544e] dark:text-[#b0c2b9]">
                  <%= item.category %>
                </span>
              </td>
              <td class="py-3 px-4 font-bold"><%= typeof G !== 'undefined' && G.currency ? G.currency : '$' %><%= item.price.toFixed ? item.price.toFixed(2) : item.price %></td>
              <td class="py-3 px-4">
                <span class="font-medium <%= item.stock < 15 ? 'text-[#d98236] font-bold' : 'text-[#44544e] dark:text-[#b0c2b9]' %>">
                  <%= item.stock %> units
                </span>
              </td>
              <td class="py-3 px-4 text-amber-500 font-bold">
                <div class="flex items-center gap-1">
                  <%- I('star', 'w-3 h-3 fill-amber-400 text-amber-400') %>
                  <span><%= item.rating %></span>
                </div>
              </td>
              <td class="py-3 px-4 text-right">
                <a href="/products/<%= item.id %>" class="text-[#2c6153] dark:text-[#64bfa9] hover:underline font-semibold">View</a>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
