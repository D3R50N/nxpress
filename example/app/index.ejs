<div class="space-y-20">

  <!-- TOP HERO + STORIES SECTION -->
  <section class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
    
    <!-- Big Hero Banner (8 cols) -->
    <div class="lg:col-span-8 relative rounded-3xl overflow-hidden min-h-[460px] md:min-h-[520px] flex flex-col justify-between p-8 sm:p-12 text-white bg-[#1a2f28]">
      <!-- Background Image with Soft Vignette -->
      <img src="https://images.unsplash.com/photo-1556911220-e15b29be8c8f?w=1600&auto=format&fit=crop&q=80" 
           alt="Eco Kitchen" 
           class="absolute inset-0 w-full h-full object-cover object-center opacity-60 mix-blend-overlay" />
      <div class="absolute inset-0 bg-gradient-to-r from-[#142822]/90 via-[#183129]/60 to-transparent"></div>

      <!-- Top Tag -->
      <div class="relative z-10">
        <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-semibold bg-white/15 backdrop-blur border border-white/20 text-white">
          <%- I('leaf', 'w-3.5 h-3.5 text-[#7bd4bc]') %>
          100% Organic & Non-Toxic
        </span>
      </div>

      <!-- Main Headline -->
      <div class="relative z-10 max-w-xl my-auto py-8">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.1] text-white">
          Eco-Friendly <br />
          <span class="font-serif-italic font-normal text-[#a6ecd9]">Kitchenware</span> for <br />
          a greener home
        </h1>
        <p class="mt-4 text-xs sm:text-sm text-white/80 max-w-md leading-relaxed">
          The eco-friendly kitchenware crafted with natural materials, designed for durability and sustainable everyday living.
        </p>

        <div class="mt-8 flex items-center gap-4">
          <a href="/products" class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-xs font-bold bg-[#fcfbf7] hover:bg-white text-[#19322a] transition-all shadow-lg hover:scale-105">
            <%= tr('shop_now') %> &rarr;
          </a>
        </div>
      </div>

      <!-- Floating Stat Glass Card -->
      <div class="relative z-10 self-end bg-white/10 dark:bg-black/30 backdrop-blur-md rounded-2xl p-4 border border-white/20 text-white max-w-[200px]">
        <div class="text-[11px] text-white/70 leading-snug">
          Natural.<br />Sustainable.<br />Eco-conscious.
        </div>
        <div class="mt-2 text-2xl font-black font-serif-italic text-[#a6ecd9]">
          96%
        </div>
      </div>
    </div>

    <!-- Right Side Story Tiles (4 cols) -->
    <div class="lg:col-span-4 grid grid-cols-2 gap-4">
      <% stories.forEach(function(story) { %>
        <a href="<%= story.url %>" class="group relative rounded-2xl overflow-hidden min-h-[220px] flex flex-col justify-end p-4 text-white bg-[#223d34]">
          <img src="<%= story.image %>" alt="<%= story.title %>" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-65" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
          
          <div class="relative z-10 text-center space-y-1">
            <span class="text-[10px] tracking-wider uppercase text-white/70 block"><%= story.subtitle %></span>
            <h4 class="text-sm font-bold font-serif-italic text-white"><%= story.title %></h4>
            <span class="inline-block mt-2 px-3 py-1 rounded-full text-[10px] font-semibold bg-white/90 text-[#1a2f28] group-hover:bg-white transition-colors">
              Shop &rarr;
            </span>
          </div>
        </a>
      <% }); %>
    </div>
  </section>

  <!-- BESTSELLING PRODUCTS SECTION -->
  <section class="space-y-8">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-[#ece7df] dark:border-[#222b27] pb-4">
      <div>
        <span class="text-xs font-semibold text-[#667a71] dark:text-[#8ea399] tracking-wider uppercase block mb-1">
          <%= tr('hero_tag') %>
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold text-[#1a2e28] dark:text-white">
          <%= tr('bestselling') %> ✧ <span class="font-serif-italic font-normal text-[#2c6153] dark:text-[#64bfa9]"><%= tr('products') %></span>
        </h2>
      </div>

      <a href="/products" class="inline-flex items-center gap-1.5 text-xs font-bold text-[#1f3d35] dark:text-[#64bfa9] hover:underline">
        <%= tr('more_products') %> &rarr;
      </a>
    </div>

    <!-- Products Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <% bestsellers.forEach(function(product) { %>
        <%- $('ProductCard', { product: product }) %>
      <% }); %>
    </div>
  </section>

  <!-- SPLIT SHOWCASE: BEST SELLERS & NEW ARRIVALS -->
  <section class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
    <!-- Left Card -->
    <div class="bg-[#f4efe6] dark:bg-[#18221e] rounded-3xl p-8 sm:p-10 border border-[#e8e2d4] dark:border-[#26352f] flex flex-col justify-between">
      <div>
        <h3 class="text-3xl font-bold text-[#1a2e28] dark:text-white">
          Best <span class="font-serif-italic font-normal text-[#2c6153] dark:text-[#64bfa9]">sellers</span>
        </h3>
        <p class="mt-3 text-xs sm:text-sm text-[#5c6e66] dark:text-[#a0b3aa] leading-relaxed max-w-sm">
          A polished cooking rice pot rests on a rustic wooden surface, encircled by fresh herbs — a perfect blend of durability and nature for mindful cooking.
        </p>
        <a href="/products?category=cookware" class="mt-6 inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full text-xs font-bold bg-[#1b362f] text-white hover:bg-[#284f45] dark:bg-[#2e5e52] transition-colors">
          Shop now &rarr;
        </a>
      </div>

      <div class="mt-8 rounded-2xl overflow-hidden aspect-video bg-white/40 dark:bg-black/20">
        <img src="https://images.unsplash.com/photo-1584990347449-35c824c9657f?w=800&auto=format&fit=crop&q=80" alt="Best sellers" class="w-full h-full object-cover" />
      </div>
    </div>

    <!-- Right Card -->
    <div class="bg-[#f4efe6] dark:bg-[#18221e] rounded-3xl p-8 sm:p-10 border border-[#e8e2d4] dark:border-[#26352f] flex flex-col justify-between">
      <div>
        <h3 class="text-3xl font-bold text-[#1a2e28] dark:text-white">
          New <span class="font-serif-italic font-normal text-[#2c6153] dark:text-[#64bfa9]">Arrival</span>
        </h3>
        <p class="mt-3 text-xs sm:text-sm text-[#5c6e66] dark:text-[#a0b3aa] leading-relaxed max-w-sm">
          A CookSteam showcases a colorful array of fresh, seasonal vegetables — a vibrant celebration of zero-waste, planet-friendly kitchen practices.
        </p>
        <a href="/products?category=appliances" class="mt-6 inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full text-xs font-bold bg-[#1b362f] text-white hover:bg-[#284f45] dark:bg-[#2e5e52] transition-colors">
          Shop now &rarr;
        </a>
      </div>

      <div class="mt-8 rounded-2xl overflow-hidden aspect-video bg-white/40 dark:bg-black/20">
        <img src="https://images.unsplash.com/photo-1574269909862-7e1d70bb8078?w=800&auto=format&fit=crop&q=80" alt="New arrival" class="w-full h-full object-cover" />
      </div>
    </div>
  </section>

  <!-- GALLERY / INSPIRATION SECTION -->
  <section id="gallery" class="space-y-6">
    <div class="text-center max-w-xl mx-auto space-y-2">
      <span class="text-xs font-semibold text-[#667a71] dark:text-[#8ea399] uppercase tracking-wider">
        Thoughtful, Planet-Prioritizing Ideas
      </span>
      <h2 class="text-2xl sm:text-3xl font-bold text-[#1a2e28] dark:text-white">
        and Inspiration ✧ <span class="font-serif-italic font-normal text-[#2c6153] dark:text-[#64bfa9]">Gallery</span>
      </h2>
    </div>

    <!-- Gallery Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
      <% gallery.forEach(function(item) { %>
        <div class="group relative rounded-2xl overflow-hidden aspect-[4/5] bg-[#223d34]">
          <img src="<%= item.image %>" alt="<%= item.title %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity p-4 flex items-end">
            <span class="text-xs font-semibold text-white leading-tight"><%= item.title %></span>
          </div>
        </div>
      <% }); %>
    </div>
  </section>

  <!-- REVIEWS & SOCIAL PROOF -->
  <section class="bg-[#f3ede3] dark:bg-[#18231f] rounded-3xl p-8 sm:p-12 border border-[#e5ded1] dark:border-[#273730] space-y-8">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-baseline gap-3">
        <span class="text-4xl sm:text-5xl font-black font-serif-title text-[#1a2e28] dark:text-white">4.9</span>
        <span class="text-sm text-[#667a71] dark:text-[#8ea399]">/ 5</span>
        <span class="text-xs text-[#5c6e66] dark:text-[#a0b3aa] font-medium ml-2">More than <strong>25,000</strong> 5-Star Reviews</span>
      </div>
      <div class="flex items-center gap-1 text-amber-500">
        <%- I('star', 'w-4 h-4 fill-amber-400 text-amber-400') %>
        <%- I('star', 'w-4 h-4 fill-amber-400 text-amber-400') %>
        <%- I('star', 'w-4 h-4 fill-amber-400 text-amber-400') %>
        <%- I('star', 'w-4 h-4 fill-amber-400 text-amber-400') %>
        <%- I('star', 'w-4 h-4 fill-amber-400 text-amber-400') %>
      </div>
    </div>

    <!-- Review Quotes Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <% reviews.forEach(function(rev) { %>
        <div class="bg-white/80 dark:bg-[#1f2d27] rounded-2xl p-6 border border-[#e8e2d5] dark:border-[#2b3c35] flex flex-col justify-between space-y-4">
          <p class="text-xs sm:text-sm text-[#3b4c45] dark:text-[#c4d6ce] italic leading-relaxed">
            &ldquo;<%= rev.text %>&rdquo;
          </p>
          <div>
            <div class="text-xs font-bold text-[#1a2e28] dark:text-white"><%= rev.author %></div>
            <div class="text-[11px] text-[#7a8c84] dark:text-[#7f948b]"><%= rev.role %></div>
          </div>
        </div>
      <% }); %>
    </div>
  </section>

</div>
