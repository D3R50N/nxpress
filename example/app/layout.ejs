<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/tailwind.css">
  <style>
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    }
    .font-serif-italic {
      font-family: 'Playfair Display', serif;
      font-style: italic;
    }
    .font-serif-title {
      font-family: 'Playfair Display', serif;
    }
  </style>
</head>
<body class="bg-[#fcfbf7] dark:bg-[#121615] text-[#2c3330] dark:text-[#e4ebe7] min-h-screen flex flex-col transition-colors duration-200 antialiased selection:bg-[#274c43] selection:text-white">
  <%- $('Navbar') %>

  <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <%- body %>
  </main>

  <%- $('Footer') %>
</body>
</html>
