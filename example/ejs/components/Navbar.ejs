<header class="bg-white/80 dark:bg-slate-800/80 backdrop-blur border-b border-slate-200 dark:border-slate-700/60 sticky top-0 z-50">
  <div class="max-w-4xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">⚡ <%= G.siteName %></a>
    <nav class="flex items-center gap-6 text-sm font-medium">
      <a href="/" class="text-slate-600 dark:text-slate-300 hover:text-sky-500 dark:hover:text-sky-400 transition-colors"><%= tr('home') %></a>
      <a href="/products" class="text-slate-600 dark:text-slate-300 hover:text-sky-500 dark:hover:text-sky-400 transition-colors"><%= tr('products_title') %></a>
      <a href="/api/health" target="_blank" class="text-slate-600 dark:text-slate-300 hover:text-sky-500 dark:hover:text-sky-400 transition-colors">API Health</a>
      <div class="flex items-center gap-1 bg-slate-100 dark:bg-slate-700/60 p-1 rounded-lg text-xs font-semibold">
        <a href="?lang=fr" class="px-2 py-1 rounded <%= R && R.locale === 'fr' ? 'bg-white dark:bg-slate-800 text-sky-500 shadow-sm' : 'text-slate-500 hover:text-slate-900 dark:text-slate-400' %>">FR</a>
        <a href="?lang=en" class="px-2 py-1 rounded <%= R && R.locale === 'en' ? 'bg-white dark:bg-slate-800 text-sky-500 shadow-sm' : 'text-slate-500 hover:text-slate-900 dark:text-slate-400' %>">EN</a>
      </div>
      <button onclick="__nxpress__.theme.toggle()" class="p-2 rounded-lg bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:text-sky-500 dark:hover:text-sky-400 transition-colors" title="Changer le thème">
        <%- I('moon', 'w-5 h-5 dark:hidden') %>
        <%- I('sun', 'w-5 h-5 hidden dark:block') %>
      </button>
    </nav>
  </div>
</header>
